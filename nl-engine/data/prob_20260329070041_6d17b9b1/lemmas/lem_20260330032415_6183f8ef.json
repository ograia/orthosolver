  "statement_lean": null,
  "statement_nl": "For all integers n and r with 0 <= r <= n, the Gaussian q-binomial coefficient [n choose r]_q := (q;q)_n / ((q;q)_r (q;q)_{n-r}), where (q;q)_m := product_{i=1}^m (1 - q^i) and (q;q)_0 := 1, is a nonzero polynomial in Z[q] of degree r(n-r).",
  "statement_semantic_sketch": {
    "domain_restrictions": [
      "n and r must be integers.",
      "The inequality 0 <= r <= n is required.",
      "The quantity n - r is therefore a nonnegative integer.",
      "The product defining (q;q)_m uses m as a nonnegative integer.",
      "(q;q)_0 is defined to be 1.",
      "The claim is about a polynomial in the indeterminate q with coefficients in the integers."
    ],
    "normalized_claim": "For every pair of integers n and r satisfying 0 <= r <= n, the expression (q;q)_n divided by the product of (q;q)_r and (q;q)_{n-r} is a well-defined nonzero polynomial in Z[q], and its degree as a polynomial in q is r times (n - r).",
    "quantifier_order": [
      "For all integers n and r, if 0 <= r <= n, then the stated property holds for the polynomial in q defined by the given formula."
