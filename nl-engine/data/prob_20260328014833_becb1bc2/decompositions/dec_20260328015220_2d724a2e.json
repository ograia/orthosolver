  "pinned_statement_signatures": {
    "lem_20260328015220_49341677": "theorem lem_20260328015220_49341677 : \u2200 (n : \u2124), n > 1 \u2192 \u2200 (x : \u211d) (z : \u2124), E n (x + (z : \u211d)) = E n x",
    "lem_20260328015226_ec8a277f": "theorem lem_20260328015226_ec8a277f : \u2200 (x : \u211d), x = (\u230ax\u230b : \u211d) + Int.fract x \u2227 0 \u2264 Int.fract x \u2227 Int.fract x < 1",
    "lem_20260328015230_76f78c29": "theorem lem_20260328015230_76f78c29 : \u2200 (n : \u2124), n > 1 \u2192 \u2200 (x : \u211d), 0 \u2264 x \u2192 x < 1 \u2192 E n x \u2264 E n ((\u230a(n : \u211d) * x\u230b : \u211d) / (n : \u211d))",
    "lem_20260328015236_05d35538": "theorem lem_20260328015236_05d35538 : \u2200 (n : \u2124), n > 1 \u2192 \u2200 (x : \u211d), ((n : \u211d) - 1) / (n : \u211d) \u2264 x \u2192 x < 1 \u2192 E n x = H n - 1",
    "lem_20260328015243_198f9fa6": "theorem lem_20260328015243_198f9fa6 : \u2200 (n : \u2124), n > 1 \u2192 \u2200 (m : \u2124), 0 \u2264 m \u2192 m \u2264 n - 1 \u2192 E n ((m : \u211d) / (n : \u211d)) \u2264 H n - 1 \u2227 (E n ((m : \u211d) / (n : \u211d)) = H n - 1 \u2194 m = n - 1)"
  },
