ENV=prod
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://orthos-app:${DB_PASSWORD}@/orthos

OPENAI_API_KEY=
OPENAI_MODEL_AGENT1=gpt-5.4
OPENAI_MODEL_AGENT2=gpt-5.4
OPENAI_MODEL_AGENT3=gpt-5.4
OPENAI_MODEL_AGENT4=gpt-5.4
OPENAI_MODEL_AGENT5=gpt-5.4
OPENAI_REASONING_EFFORT=none
OPENAI_TEXT_VERBOSITY=medium
OPENAI_USAGE_PERSISTENCE_MODE=immediate

LEAN_ENGINE_BASE_URL=https://lean-engine-prod-<hash>-uc.a.run.app
LEAN_ENGINE_TIMEOUT_SECONDS=30
LEAN_POLL_INTERVAL_SECONDS=5
LEAN_ENGINE_AUTH_MODE=oidc
LEAN_ENGINE_OIDC_AUDIENCE=https://lean-engine-prod-<hash>-uc.a.run.app
LEAN_ENGINE_OIDC_TOKEN_SOURCE=google_adc
LEAN_ENGINE_OIDC_TOKEN_ENV_VAR=LEAN_ENGINE_OIDC_TOKEN

ARTIFACT_STORE_DIR=.artifacts
SSE_HEARTBEAT_SECONDS=15

WORKER_DEFAULT_MAX_CONCURRENCY=12
WORKER_DEFAULT_MAX_PENDING=256
WORKER_LEASE_SECONDS=120

OPENAI_PRICE_INPUT_PER_1K=0.0005
OPENAI_PRICE_OUTPUT_PER_1K=0.0015
