# Required
OPENAI_API_KEY=

# Per-problem JSON config overrides model/thinking/verbosity per agent.
# These env vars set the server-wide defaults (used when JSON config omits a field).
# OPENAI_MODEL_AGENT1=gpt-5-mini
# OPENAI_MODEL_AGENT2=gpt-5-mini
# OPENAI_MODEL_AGENT3=gpt-5-mini
# OPENAI_MODEL_AGENT4=gpt-5-mini
# OPENAI_MODEL_AGENT5=gpt-5-mini
# OPENAI_REASONING_EFFORT=none
# OPENAI_TEXT_VERBOSITY=low

# Lean engine (only needed if running formal verification)
# LEAN_ENGINE_BASE_URL=http://localhost:8081
# LEAN_ENGINE_AUTH_MODE=none

# All other settings have sensible defaults in src/nl_engine/settings.py
