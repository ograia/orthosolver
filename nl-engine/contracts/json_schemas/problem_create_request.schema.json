{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProblemCreateRequest",
  "type": "object",
  "required": ["title", "statement_nl", "config"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "statement_nl": {"type": "string", "minLength": 1},
    "statement_lean": {"type": ["string", "null"]},
    "imports": {
      "type": "array",
      "items": {"type": "string"},
      "default": ["Mathlib"]
    },
    "lean_image_tag": {"type": "string"},
    "initial_trusted_context": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decl_name": {"type": "string"},
          "lean_code": {"type": "string"}
        },
        "required": ["decl_name", "lean_code"],
        "additionalProperties": true
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "object",
          "properties": {
            "nl_only_mode": {"type": "boolean"}
          },
          "required": ["nl_only_mode"],
          "additionalProperties": true
        }
      },
      "required": ["mode"],
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
