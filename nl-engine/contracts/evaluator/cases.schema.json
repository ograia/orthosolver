{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orthos-ai.com/contracts/evaluator/cases.schema.json",
  "title": "Orthos Evaluator Cases",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "title", "statement_nl", "mode", "expected_terminal_status", "expected_verification_level"],
        "properties": {
          "case_id": { "type": "string" },
          "title": { "type": "string" },
          "statement_nl": { "type": "string" },
          "mode": { "type": "string", "enum": ["nl_only", "standard"] },
          "expected_terminal_status": { "type": "string", "enum": ["succeeded", "failed"] },
          "expected_verification_level": { "type": "string", "enum": ["nl_only", "formal"] },
          "expected_failure_reason": { "type": ["string", "null"] },
          "routing_invariants": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Expected stage names that must appear in /events"
          },
          "config_overrides": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
